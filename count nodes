class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


def count_nodes(head):
    count = 0
    current = head

    while current is not None:
        count += 1
        current = current.next

    return count


# Create nodes
head = Node(10)
head.next = Node(20)
head.next.next = Node(30)
head.next.next.next = Node(40)

print("Number of nodes:", count_nodes(head))
