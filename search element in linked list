class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


def search(head, key):
    current = head

    while current is not None:
        if current.data == key:
            return True
        current = current.next

    return False


# Create linked list
head = Node(10)
head.next = Node(20)
head.next.next = Node(30)
head.next.next.next = Node(40)

# Search
key = 30

if search(head, key):
    print("Element found")
else:
    print("Element not found")
