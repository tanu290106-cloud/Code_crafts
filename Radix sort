def radix_sort(arr):
    max_num = max(arr)
    exp = 1

    while max_num // exp > 0:
        output = [0] * len(arr)
        count = [0] * 10

        for num in arr:
            digit = (num // exp) % 10
            count[digit] += 1

        for i in range(1, 10):
            count[i] += count[i - 1]

        for i in range(len(arr) - 1, -1, -1):
            digit = (arr[i] // exp) % 10
            output[count[digit] - 1] = arr[i]
            count[digit] -= 1

        arr[:] = output
        exp *= 10


arr = [170, 45, 75, 90, 802, 24, 2, 66]

radix_sort(arr)

print("Sorted array:", arr)
